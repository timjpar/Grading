{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "next build",
  "outputDirectory": "out",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.mountainmoversgrading.com" }],
      "destination": "https://mountainmoversgrading.com/:path*",
      "permanent": true
    }
  ]
}
